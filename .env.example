# REQUIRED: keep the real value only in Railway Variables, never GitHub.
ANTHROPIC_API_KEY=

# Current model from the original project. Change in Railway without changing code.
ANTHROPIC_MODEL=claude-sonnet-4-6

# STRONGLY RECOMMENDED for a private/demo deployment.
# When both are set, the entire app is protected by browser Basic Auth over HTTPS.
APP_USERNAME=underwriter
APP_PASSWORD=replace-with-a-long-random-password

# Optional: comma-separated hosts allowed to reach the app.
# Example: underwriting-production.up.railway.app,localhost:5173
ALLOWED_HOSTS=

# Optional EmailJS browser configuration. EmailJS public keys are client-side identifiers,
# not server secrets. Leave blank to disable the email button.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
