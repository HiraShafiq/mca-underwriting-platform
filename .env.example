# REQUIRED. Keep the real value only in your hosting provider's environment variables.
ANTHROPIC_API_KEY=

# AI model used by the server-side API functions.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional EmailJS browser configuration. These are client-side identifiers.
# Never place a private API key, database password, or server secret in a VITE_ variable.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
